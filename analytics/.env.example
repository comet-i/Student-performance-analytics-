# --- online service (Render + local) ---
# Shared secret: must equal ML_ENGINE_API_KEY on the backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_ENGINE_API_KEY=<long random string>
MODEL_PATH=artifacts/model_v1.joblib
ENABLE_DOCS=false

# --- offline scripts only (train.py, nightly_batch.py) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
# Nightly batch calls the engine over HTTP:
ANALYTICS_URL=http://127.0.0.1:8000
